#!/usr/bin/env python3
"""In-memory GNSS stop observation. No file I/O or actuator commands."""
import math
import signal
import threading
import time

import rclpy
from rclpy.node import Node
from rclpy.signals import SignalHandlerOptions
from rclpy.qos import qos_profile_sensor_data
from builtin_interfaces.msg import Time
from nav_msgs.msg import Odometry
from vehicle_recorder.msg import CommandEvent, StopStatus
from stop_observation import Sample, StopObservation


def ns(stamp):
    return stamp.sec * 1_000_000_000 + stamp.nanosec if stamp.sec >= 0 and 0 <= stamp.nanosec < 1_000_000_000 else 0


def stamp(value):
    return Time(sec=value // 1_000_000_000, nanosec=value % 1_000_000_000)


class StopObserver(Node):
    def __init__(self):
        super().__init__('stop_monitor')
        defaults = dict(command_topic='', command_events_topic='/vehicle/command_events',
                        gnss_topic='', status_topic='',
                        map_frame='map', base_frame='base_link', stop_speed_mps=0.1,
                        stop_hold_s=0.5, sample_timeout_s=0.3, max_speed_variance=1.0,
                        max_position_std_m=3.0)
        self.settings = {key: self.declare_parameter(key, value).value for key, value in defaults.items()}
        # 고규범 신규 로직: common control pipeline wiring, with explicit standalone overrides.
        for key, common, fallback in (('command_topic', 'topics.actuator_raw', '/cmd'),
                                      ('gnss_topic', 'topics.gnss', '/gnss/odom'),
                                      ('status_topic', 'topics.stop_status', '/vehicle/stop_status')):
            value = self.declare_parameter(common, fallback).value
            self.settings[key] = self.settings[key] or value
        for key in ('max_speed_variance', 'max_position_std_m'):
            if not math.isfinite(self.settings[key]) or self.settings[key] <= 0:
                raise ValueError(key + ' must be finite and positive')
        self.observation = StopObservation(self.settings['stop_speed_mps'], self.settings['stop_hold_s'],
                                           self.settings['sample_timeout_s'])
        self.command_topic = self.resolve_topic_name(self.settings['command_topic'])
        self.publisher = self.create_publisher(StopStatus, self.settings['status_topic'], 10)
        self.create_subscription(CommandEvent, self.settings['command_events_topic'], self.command, 100)
        self.create_subscription(Odometry, self.settings['gnss_topic'], self.odometry, qos_profile_sensor_data)
        self.create_timer(0.05, self.publish)

    def command(self, message):
        if message.command_topic != self.command_topic:
            return
        if not all(math.isfinite(v) for v in (message.steering_raw, message.speed_raw)):
            return
        now_ns, received_s = self.get_clock().now().nanoseconds, time.monotonic()
        stopping = message.brake and message.speed_raw == 0.0
        transition = self.observation.command(ns(message.header.stamp), message.stage, stopping, received_s, now_ns)
        if transition:
            # 고규범 신규 로직: normal command events need no additional status heartbeat.
            self.publish()

    def odometry(self, message):
        now_ns, received_s = self.get_clock().now().nanoseconds, time.monotonic()
        value, variance = message.twist.twist.linear.x, message.twist.covariance[0]
        speed_valid = bool(message.header.frame_id == self.settings['map_frame'] and
                       message.child_frame_id == self.settings['base_frame'] and math.isfinite(value) and
                       math.isfinite(variance) and 0 <= variance <= self.settings['max_speed_variance'])
        x, y = message.pose.pose.position.x, message.pose.pose.position.y
        vx, vy = message.pose.covariance[0], message.pose.covariance[7]
        position_valid = bool(message.header.frame_id == self.settings['map_frame'] and
                          all(math.isfinite(v) for v in (x, y, vx, vy)) and vx >= 0 and vy >= 0 and
                          vx + vy <= self.settings['max_position_std_m'] ** 2)
        sample = Sample(ns(message.header.stamp), received_s, value, speed_valid, x, y, position_valid)
        self.observation.observe(sample, now_ns)
        self.publish()

    def publish(self):
        now = self.get_clock().now()
        data = self.observation.snapshot(now.nanoseconds, time.monotonic())
        message = StopStatus()
        message.header.stamp = now.to_msg()
        message.header.frame_id = self.settings['map_frame']
        message.command_topic = self.command_topic
        for key in ('stop_id', 'command_active', 'command_fresh', 'speed_valid', 'speed_mps',
                    'stopped', 'distance_valid', 'distance_m', 'reason'):
            setattr(message, key, data[key])
        for field, key in (('sample_stamp', 'sample_ns'), ('stopped_since', 'stopped_since_ns'),
                           ('confirmed_at', 'confirmed_at_ns'), ('command_stamp', 'command_ns'),
                           ('transmit_stamp', 'transmit_ns')):
            setattr(message, field, stamp(data[key]))
        for prefix in ('command', 'transmit', 'stop'):
            position = data[prefix + '_position']
            setattr(message, prefix + '_position_valid', position is not None)
            if position is not None:
                setattr(message, prefix + '_x_m', position[0])
                setattr(message, prefix + '_y_m', position[1])
        self.publisher.publish(message)


def main():
    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
    stopping = threading.Event()
    for signum in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, lambda *_: stopping.set())
    node = None
    try:
        node = StopObserver()
        while rclpy.ok() and not stopping.is_set():
            rclpy.spin_once(node, timeout_sec=.1)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
